# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Arbitrum RPC
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Swap API Keys
NEXT_PUBLIC_1INCH_API_KEY=your_1inch_api_key_here

# Alpaca Paper Trading API (get keys from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Escrow smart contract (populated after deploying contracts/Escrow.sol)
ESCROW_CONTRACT_ADDRESS=

# Deployment (optional — used by scripts/deploy.mjs)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PRIVATE_KEY=your_deployer_private_key_here

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
